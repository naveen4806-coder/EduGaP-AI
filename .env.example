# ============================================================================
# EdUGaP AI - Environment Variables Reference
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Supabase Configuration (PostgreSQL, Auth, RLS, and Storage)
# Required for Cloud Supabase database. If unset, EdUGaP AI runs in zero-config
# local mode with pre-seeded demo accounts and data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Buckets (Pre-configured in migrations)
SUPABASE_RESOURCES_BUCKET=resources
SUPABASE_SUBMISSIONS_BUCKET=student-submissions

# Machine Learning Service (PyTorch MLP FastAPI server)
ML_SERVICE_URL=http://127.0.0.1:8001

# AI Service Layer (OpenAI Compatible)
# If left empty, EdUGaP AI utilizes intelligent offline heuristic evaluators
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Firebase Cloud Messaging (FCM) - Optional Push Notifications
# Note: Firebase is used strictly for optional device notifications, NOT for Auth or Firestore
FIREBASE_SERVER_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
